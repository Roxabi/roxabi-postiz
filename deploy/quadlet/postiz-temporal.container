[Unit]
Description=Temporal server for Postiz
After=postiz-temporal-db.service postiz-temporal-es.service
Requires=postiz-temporal-db.service postiz-temporal-es.service

[Container]
DropCapability=all
NoNewPrivileges=true
Image=docker.io/temporalio/auto-setup:1.28.1
ContainerName=postiz-temporal
Network=postiz.network
PublishPort=127.0.0.1:7233:7233
Environment=DB=postgres12
Environment=DB_PORT=5432
Environment=POSTGRES_USER=temporal
Environment=POSTGRES_PWD=temporal
Environment=POSTGRES_SEEDS=postiz-temporal-db
Environment=DYNAMIC_CONFIG_FILE_PATH=config/dynamicconfig/development-sql.yaml
Environment=ENABLE_ES=true
Environment=ES_SEEDS=postiz-temporal-es
Environment=ES_VERSION=v7
Environment=TEMPORAL_NAMESPACE=default
Volume=%h/.roxabi/postiz/data/dynamicconfig:/etc/temporal/config/dynamicconfig:Z

[Install]
WantedBy=default.target
