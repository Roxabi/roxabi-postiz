[Unit]
Description=Postiz PostgreSQL database

[Container]
Image=docker.io/library/postgres:17-alpine
ContainerName=postiz-db
Network=postiz.network
Environment=POSTGRES_PASSWORD=postiz-password
Environment=POSTGRES_USER=postiz-user
Environment=POSTGRES_DB=postiz-db-local
HealthCmd=pg_isready -U postiz-user -d postiz-db-local
HealthInterval=10s
HealthRetries=3
HealthTimeout=3s
Volume=%h/.roxabi/postiz/data/postgres:/var/lib/postgresql/data:Z

[Install]
WantedBy=default.target
